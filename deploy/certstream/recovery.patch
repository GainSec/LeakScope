@@ -0,0 +1,21 @@
+package certificatetransparency
+
+import "testing"
+
+func TestLeakScopeRecoveryStart(t *testing.T) {
+    tests := []struct{name string; saved,tail uint64; enabled bool; want uint64}{
+        {"missing cursor",0,500000,true,500000},
+        {"empty new log",0,0,true,0},
+        {"resume recent cursor",120,125,true,120},
+        {"bounded replay",100,50000,true,50000},
+        {"invalid future cursor",200,125,true,125},
+        {"explicit no recovery",120,125,false,125},
+    }
+    for _, item := range tests {
+        t.Run(item.name,func(t *testing.T){
+            if got:=recoveryStartIndex(item.saved,item.tail,item.enabled); got!=item.want {
+                t.Fatalf("got %d, want %d",got,item.want)
+            }
+        })
+    }
+}
