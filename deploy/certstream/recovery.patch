+package certificatetransparency
+
+import (
+    "log"
+    "github.com/d-Rickyy-b/certstream-server-go/internal/metrics"
+)
+
+const recoveryMaxReplay uint64 = 10000
+
+// Missing cursors (including newly added logs) must never replay from genesis.
+// A bounded recovery window deliberately reports and skips larger coverage gaps.
+func recoveryStartIndex(saved, tail uint64, enabled bool) uint64 {
+    if !enabled || saved == 0 {
+        metrics.LiveTailBootstraps.Inc()
+        log.Printf("LeakScope: bootstrap CT log at live tail %d", tail)
+        return tail
+    }
+    if saved > tail || tail-saved > recoveryMaxReplay {
+        metrics.RecoveryGaps.Inc()
+        log.Printf("LeakScope: CT recovery gap; saved=%d tail=%d; restarting at tail", saved, tail)
+        return tail
+    }
+    return saved
+}
